# Copy to .env.local for local development. On Vercel these are Project Environment Variables.

# Postgres connection string (Vercel Marketplace > Neon sets this automatically).
# Leave it out locally: `npm run dev` then uses a built-in local database in .pglite/.
DATABASE_URL=

# Shared secret the ESP32-CAM sends in the X-Device-Api-Key header (also in firmware secrets.h).
DEVICE_API_KEY=

# Code a teacher must enter to create a teacher account.
TEACHER_SIGNUP_CODE=

# Web Push keys for phone notifications (generate once with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
